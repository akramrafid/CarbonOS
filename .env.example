# ==============================================================================
# CarbonOS Root Environment Variable Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# --- AI & Large Language Model Services ---
# Google Gemini API key for ESG RAG and crop disease diagnosis
GEMINI_API_KEY=your_gemini_api_key_here

# --- Earth Observation & Satellite APIs (dMRV) ---
# Copernicus Data Space Ecosystem (CDSE) for Sentinel-1 and Sentinel-2 downloads
COPERNICUS_USERNAME=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# NASA Earthdata (LP DAAC, GEDI, Landsat)
EARTHDATA_USERNAME=your_nasa_earthdata_username_here
EARTHDATA_PASSWORD=your_nasa_earthdata_password_here

# Google Earth Engine Cloud Project ID
EARTHENGINE_PROJECT=your_google_earth_engine_project_id_here

# --- Weather Telemetry (Backend Services Only) ---
# OpenWeatherMap API keys for agricultural micro-climate risk calculations
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_AGRO_API_KEY=your_openweather_agro_api_key_here

# --- ESG Accounting & Token Authentication ---
# Mode: isolated_demo | production
ESG_ACCESS_MODE=isolated_demo
# Minimum 32-character secret for signing ESG session and audit JWTs
ESG_AUTH_JWT_SECRET=your_minimum_32_character_jwt_secret_key_here

# --- Frontend Client Configuration (Vite import.meta.env) ---
VITE_FASTAPI_API_URL=http://localhost:8000
VITE_DJANGO_API_URL=http://localhost:8000
VITE_BLYNK_AUTH_TOKEN=

