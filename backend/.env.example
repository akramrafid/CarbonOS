# ==============================================================================
# CarbonOS Django Backend Environment Variable Template
# Copy this file to backend/.env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Django Secret Key (Generate a secure 50+ character random string in production)
DJANGO_SECRET_KEY=your_django_secret_key_here

# Debug Mode: Set to False in staging and production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,carbon-os-beta.vercel.app

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://carbon-os-beta.vercel.app

# Database Connection (Defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/carbonos_db

# Inter-Service Communication: FastAPI Inference Microservice URL
FASTAPI_URL=http://127.0.0.1:8000/predict

# Third-Party Weather APIs for Agricultural Risk Calculations
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_AGRO_API_KEY=your_openweather_agro_api_key_here

# National Registry Bridge API Authentication
NATIONAL_REGISTRY_API_KEY=your_sandbox_national_registry_api_key_here

# Security Headers (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000

