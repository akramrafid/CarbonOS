# ==============================================================================
# CarbonOS FastAPI Inference & dMRV Environment Variable Template
# Copy this file to inference/.env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Google Gemini API Key for Plant Pathology Diagnosis and ESG RAG
GEMINI_API_KEY=your_gemini_api_key_here

# Copernicus Data Space Ecosystem (CDSE) Credentials (Sentinel-1 / Sentinel-2)
COPERNICUS_USERNAME=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# NASA Earthdata Credentials (GEDI, Landsat, LP DAAC)
EARTHDATA_USERNAME=your_nasa_earthdata_username_here
EARTHDATA_PASSWORD=your_nasa_earthdata_password_here

# Google Earth Engine Project ID
EARTHENGINE_PROJECT=your_google_earth_engine_project_id_here

# ESG RAG & Accounting Configuration
ESG_ACCESS_MODE=isolated_demo
ESG_AUTH_JWT_SECRET=your_minimum_32_character_jwt_secret_key_here
ESG_LLM_EXTRACTION_ENABLED=false

# Allowed CORS Origins for FastAPI Middleware
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://carbon-os-beta.vercel.app

